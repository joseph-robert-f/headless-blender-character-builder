{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-spec-v1.schema.json",
  "title": "CharacterSpec v1",
  "description": "A bounded declarative character specification; it is not a Blender operation graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "name",
    "style",
    "height_mm",
    "pose",
    "palette",
    "proportions"
  ],
  "properties": {
    "spec_version": {"const": "character/v1"},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 '-]{0,62}[A-Za-z0-9])?$(?![\\s\\S])"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "style": {"enum": ["geometric", "low_poly", "chibi"]},
    "height_mm": {"type": "number", "minimum": 25, "maximum": 250},
    "pose": {"enum": ["standing", "wave", "heroic"]},
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9A-F]{6}$(?![\\s\\S])"}
    },
    "proportions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_scale", "limb_scale"],
      "properties": {
        "head_scale": {"type": "number", "minimum": 0.7, "maximum": 1.6},
        "body_scale": {"type": "number", "minimum": 0.7, "maximum": 1.4, "default": 1},
        "limb_scale": {"type": "number", "minimum": 0.7, "maximum": 1.3}
      }
    },
    "material_preset": {
      "enum": ["matte", "satin", "glossy"],
      "default": "matte"
    },
    "eye_preset": {
      "enum": ["round", "visor", "sleepy"],
      "default": "round"
    },
    "components": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "default": [],
      "not": {
        "allOf": [
          {"contains": {"const": "stub-tail"}},
          {"contains": {"const": "swept-tail"}}
        ]
      },
      "items": {
        "enum": [
          "antenna-pair",
          "backpack",
          "chest-badge",
          "long-horns",
          "pointed-ears",
          "round-ears",
          "short-horns",
          "stub-tail",
          "swept-tail"
        ]
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width_mm", "depth_mm", "height_mm"],
      "default": {"preset": "round", "width_mm": 48, "depth_mm": 48, "height_mm": 5},
      "properties": {
        "preset": {"enum": ["none", "round", "square", "hexagonal"]},
        "width_mm": {"type": "number", "minimum": 0, "maximum": 160},
        "depth_mm": {"type": "number", "minimum": 0, "maximum": 160},
        "height_mm": {"type": "number", "minimum": 0, "maximum": 25}
      },
      "allOf": [
        {
          "if": {"properties": {"preset": {"const": "none"}}, "required": ["preset"]},
          "then": {
            "properties": {
              "width_mm": {"const": 0},
              "depth_mm": {"const": 0},
              "height_mm": {"const": 0}
            }
          },
          "else": {
            "properties": {
              "width_mm": {"minimum": 20},
              "depth_mm": {"minimum": 20},
              "height_mm": {"minimum": 2}
            }
          }
        }
      ]
    }
  }
}

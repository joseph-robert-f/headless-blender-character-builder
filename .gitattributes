* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Keep the install-test archive bytes equal to their reviewed Git blobs.
/scripts/test-review-preview-install-windows.ps1 text eol=lf
/scripts/test-review-preview-servercore.ps1 text eol=lf
*.blend binary
*.glb binary
*.stl binary
*.3mf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
# Preserve exact, checksum-reviewed upstream notices, including upstream spaces.
/packaging/notices/* -whitespace

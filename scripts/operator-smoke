#!/usr/bin/env python3
"""Bounded black-box smoke test for an explicitly authorized G8 target.

With no target this command is deliberately a successful conditional skip.  A
live run accepts credentials only through a protected token file, refuses HTTP
outside an explicitly enabled loopback test mode, and never logs response
bodies or signed download URLs.
"""

from __future__ import annotations

import argparse
import hashlib
import ipaddress
import math
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import datetime, timezone
from decimal import Decimal
from http.client import HTTPException
from pathlib import Path
from typing import Any, Callable, Iterable, Mapping, Optional
from uuid import UUID, uuid4


ROOT = Path(__file__).resolve().parents[1]
SERVICE_SOURCE = ROOT / "service" / "src"
for source_root in (ROOT, SERVICE_SOURCE):
    if str(source_root) not in sys.path:
        sys.path.insert(0, str(source_root))

from hbcb_service.auth import validate_service_token
from hbcb_service.errors import AuthorizationError
from hbcb_service.models import (
    ARTIFACT_CONTENT_TYPES,
    MAX_PUBLISHED_BYTES,
    REQUIRED_PUBLISHED_ARTIFACTS,
)
from shared import (
    BuildManifest,
    ContractValidationError,
    QualityReport,
    canonical_json_bytes,
    validate_build_request,
    validate_manifest,
    validate_quality_report,
)
from shared.json_contract import MAX_BUILD_REQUEST_BYTES, decode_json_document


MAX_JSON_RESPONSE_BYTES = 1024 * 1024
MAX_SIGNED_URL_CHARACTERS = 4096
MAX_TOKEN_FILE_BYTES = 4096
MAX_POLL_SECONDS = 3600.0
MAX_POLL_INTERVAL_SECONDS = 30.0
MAX_POLL_REQUESTS = 10_000
MAX_REQUEST_TIMEOUT_SECONDS = 120.0
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")
AMZ_DATE_PATTERN = re.compile(r"^[0-9]{8}T[0-9]{6}Z$")
UTC_TIMESTAMP_PATTERN = re.compile(
    r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{3})?Z$"
)
DNS_LABEL_PATTERN = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
TERMINAL_STATUSES = frozenset({"succeeded", "failed", "canceled", "needs_review"})
BUILD_STATUSES = frozenset(
    {
        "validating",
        "queued",
        "running",
        "geometry_qa",
        "rendering",
        *TERMINAL_STATUSES,
    }
)
BUILD_DOCUMENT_FIELDS = frozenset(
    {
        "build_id",
        "request_sha256",
        "spec_sha256",
        "status",
        "state_version",
        "max_attempts",
        "cancel_requested_at",
        "terminal_code",
        "manifest_sha256",
        "manifest_bytes",
        "created_at",
        "updated_at",
        "finished_at",
        "published_at",
        "artifacts_url",
    }
)
ARTIFACT_DOCUMENT_FIELDS = frozenset(
    {"build_id", "published_at", "expires_in_seconds", "artifacts"}
)
ARTIFACT_ENTRY_FIELDS = frozenset(
    {"path", "content_type", "bytes", "sha256", "download_url"}
)


class SmokeFailure(Exception):
    """A stable failure code whose details are safe to omit from all output."""

    def __init__(self, code: str) -> None:
        super().__init__(code)
        self.code = code


def require(condition: bool, code: str) -> None:
    if not condition:
        raise SmokeFailure(code)


def _utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _valid_host(host: str) -> bool:
    try:
        host.encode("ascii", "strict")
    except UnicodeEncodeError:
        return False
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        pass
    if len(host) > 253 or host.endswith("."):
        return False
    return all(DNS_LABEL_PATTERN.fullmatch(label) is not None for label in host.split("."))


def _printable_ascii(value: str) -> bool:
    return value.isascii() and all(0x21 <= ord(character) <= 0x7E for character in value)


def _is_literal_loopback(host: str) -> bool:
    if host.lower() == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


@dataclass(frozen=True)
class Origin:
    scheme: str
    host: str
    port: int

    @property
    def base_url(self) -> str:
        rendered_host = f"[{self.host}]" if ":" in self.host else self.host
        default = 443 if self.scheme == "https" else 80
        suffix = "" if self.port == default else f":{self.port}"
        return f"{self.scheme}://{rendered_host}{suffix}"


def _origin_from_split(parts: urllib.parse.SplitResult, *, code: str) -> Origin:
    try:
        host = parts.hostname
        port = parts.port
    except ValueError as exc:
        raise SmokeFailure(code) from exc
    require(parts.scheme in ("http", "https"), code)
    require(host is not None and _valid_host(host), code)
    require(parts.username is None and parts.password is None, code)
    effective_port = port if port is not None else (443 if parts.scheme == "https" else 80)
    require(1 <= effective_port <= 65535, code)
    try:
        normalized_host = str(ipaddress.ip_address(host))
    except ValueError:
        normalized_host = host.lower()
    return Origin(parts.scheme, normalized_host, effective_port)


def validate_target_url(value: str, *, allow_loopback_http: bool) -> Origin:
    require(
        isinstance(value, str)
        and _printable_ascii(value)
        and "?" not in value
        and "#" not in value,
        "target_url_rejected",
    )
    try:
        parts = urllib.parse.urlsplit(value)
    except (TypeError, ValueError) as exc:
        raise SmokeFailure("target_url_rejected") from exc
    require(parts.path in ("", "/"), "target_url_rejected")
    require(not parts.query and not parts.fragment, "target_url_rejected")
    origin = _origin_from_split(parts, code="target_url_rejected")
    if origin.scheme == "http":
        require(allow_loopback_http, "target_https_required")
        require(_is_literal_loopback(origin.host), "target_loopback_required")
    return origin


def parse_artifact_host(value: str) -> Origin:
    """Parse an explicit HTTPS artifact authority such as assets.example:8443."""

    require(
        isinstance(value, str)
        and value != ""
        and _printable_ascii(value)
        and all(character not in value for character in "/?#@"),
        "artifact_host_rejected",
    )
    try:
        parts = urllib.parse.urlsplit("https://" + value)
    except ValueError as exc:
        raise SmokeFailure("artifact_host_rejected") from exc
    require(parts.path in ("", "/"), "artifact_host_rejected")
    require(not parts.query and not parts.fragment, "artifact_host_rejected")
    origin = _origin_from_split(parts, code="artifact_host_rejected")
    require(origin.scheme == "https", "artifact_host_rejected")
    return origin


def validate_signed_download_url(
    value: str,
    *,
    target_origin: Origin,
    allowed_artifact_origins: frozenset[Origin],
    expires_in_seconds: int,
) -> str:
    require(
        isinstance(value, str) and 1 <= len(value) <= MAX_SIGNED_URL_CHARACTERS,
        "signed_url_rejected",
    )
    require(_printable_ascii(value), "signed_url_rejected")
    try:
        parts = urllib.parse.urlsplit(value)
    except ValueError as exc:
        raise SmokeFailure("signed_url_rejected") from exc
    require(parts.fragment == "", "signed_url_rejected")
    require(parts.path.startswith("/") and not parts.path.startswith("//"), "signed_url_rejected")
    origin = _origin_from_split(parts, code="signed_url_rejected")
    if origin != target_origin:
        require(origin.scheme == "https", "signed_url_cross_origin")
        require(origin in allowed_artifact_origins, "signed_url_cross_origin")
    pairs = urllib.parse.parse_qsl(parts.query, keep_blank_values=True, strict_parsing=False)
    require(len(pairs) <= 64, "signed_url_rejected")

    def exactly_one(name: str, code: str) -> str:
        values = [item for key, item in pairs if key == name]
        require(len(values) == 1 and values[0] != "", code)
        return values[0]

    exactly_one("versionId", "signed_url_unversioned")
    require(
        exactly_one("X-Amz-Algorithm", "signed_url_unsigned") == "AWS4-HMAC-SHA256",
        "signed_url_unsigned",
    )
    require(len(exactly_one("X-Amz-Credential", "signed_url_unsigned")) <= 1024, "signed_url_rejected")
    require(
        AMZ_DATE_PATTERN.fullmatch(exactly_one("X-Amz-Date", "signed_url_unsigned")) is not None,
        "signed_url_unsigned",
    )
    expires = exactly_one("X-Amz-Expires", "signed_url_unsigned")
    require(expires.isascii() and expires.isdigit(), "signed_url_unsigned")
    require(int(expires) == expires_in_seconds, "signed_url_expiry_mismatch")
    require(len(exactly_one("X-Amz-SignedHeaders", "signed_url_unsigned")) <= 512, "signed_url_rejected")
    require(
        SHA256_PATTERN.fullmatch(exactly_one("X-Amz-Signature", "signed_url_unsigned")) is not None,
        "signed_url_unsigned",
    )
    return value


def read_token_file(path: Path) -> str:
    """Read one service token without following a symlink or accepting loose mode bits."""

    try:
        before = path.lstat()
    except OSError as exc:
        raise SmokeFailure("token_file_rejected") from exc
    require(stat.S_ISREG(before.st_mode) and not stat.S_ISLNK(before.st_mode), "token_file_rejected")
    require(stat.S_IMODE(before.st_mode) == 0o600, "token_file_permissions")
    require(0 < before.st_size <= MAX_TOKEN_FILE_BYTES, "token_file_rejected")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise SmokeFailure("token_file_rejected") from exc
    try:
        opened = os.fstat(descriptor)
        require(stat.S_ISREG(opened.st_mode), "token_file_rejected")
        require(stat.S_IMODE(opened.st_mode) == 0o600, "token_file_permissions")
        require(
            (opened.st_dev, opened.st_ino, opened.st_size)
            == (before.st_dev, before.st_ino, before.st_size),
            "token_file_changed",
        )
        payload = bytearray()
        while True:
            chunk = os.read(descriptor, 1024)
            if not chunk:
                break
            payload.extend(chunk)
            require(len(payload) <= MAX_TOKEN_FILE_BYTES, "token_file_rejected")
        after = os.fstat(descriptor)
        require(
            (after.st_dev, after.st_ino, after.st_size)
            == (opened.st_dev, opened.st_ino, len(payload)),
            "token_file_changed",
        )
    finally:
        os.close(descriptor)
    try:
        text = bytes(payload).decode("ascii", "strict")
    except UnicodeDecodeError as exc:
        raise SmokeFailure("token_file_rejected") from exc
    if text.endswith("\r\n"):
        text = text[:-2]
    elif text.endswith(("\n", "\r")):
        text = text[:-1]
    require("\n" not in text and "\r" not in text, "token_file_multiline")
    try:
        return validate_service_token(text)
    except AuthorizationError as exc:
        raise SmokeFailure("token_file_rejected") from exc


def _bounded_read(stream: Any, maximum: int) -> bytes:
    payload = bytearray()
    while True:
        chunk = stream.read(min(64 * 1024, maximum + 1 - len(payload)))
        if not chunk:
            break
        payload.extend(chunk)
        require(len(payload) <= maximum, "response_too_large")
    return bytes(payload)


class RejectRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        request: Any,
        file_pointer: Any,
        code: int,
        message: str,
        headers: Any,
        new_url: str,
    ) -> None:
        del request, file_pointer, code, message, headers, new_url
        return None


class HttpTransport:
    def __init__(self, opener: Optional[Any] = None) -> None:
        self._opener = opener or urllib.request.build_opener(RejectRedirects())

    def request(
        self,
        url: str,
        method: str,
        *,
        headers: Optional[Mapping[str, str]] = None,
        body: Optional[bytes] = None,
        timeout: float,
    ) -> tuple[int, Mapping[str, str], bytes]:
        request = urllib.request.Request(
            url,
            data=body,
            headers=dict(headers or {}),
            method=method,
        )
        try:
            with self._opener.open(request, timeout=timeout) as response:
                status = int(response.status)
                require(not 300 <= status < 400, "redirect_rejected")
                require(response.geturl() == url, "redirect_rejected")
                payload = _bounded_read(response, MAX_JSON_RESPONSE_BYTES)
                return status, dict(response.headers.items()), payload
        except urllib.error.HTTPError as exc:
            try:
                status = int(exc.code)
                require(not 300 <= status < 400, "redirect_rejected")
                payload = _bounded_read(exc, MAX_JSON_RESPONSE_BYTES)
                return status, dict(exc.headers.items()), payload
            finally:
                exc.close()
        except SmokeFailure:
            raise
        except (urllib.error.URLError, TimeoutError, HTTPException, OSError) as exc:
            raise SmokeFailure("http_transport_failed") from exc

    def download(
        self,
        url: str,
        *,
        expected_bytes: int,
        expected_content_type: str,
        timeout: float,
        capture: bool,
    ) -> tuple[str, int, Optional[bytes]]:
        # Deliberately no Authorization header: a signed URL is its own bounded credential.
        request = urllib.request.Request(url, headers={"Accept": "*/*"}, method="GET")
        try:
            response = self._opener.open(request, timeout=timeout)
        except urllib.error.HTTPError as exc:
            try:
                if 300 <= int(exc.code) < 400:
                    raise SmokeFailure("redirect_rejected")
                raise SmokeFailure("artifact_download_failed")
            finally:
                exc.close()
        except (urllib.error.URLError, TimeoutError, HTTPException, OSError) as exc:
            raise SmokeFailure("artifact_transport_failed") from exc
        try:
            require(int(response.status) == 200, "artifact_download_failed")
            require(response.geturl() == url, "redirect_rejected")
            encoding = response.headers.get("Content-Encoding")
            require(encoding in (None, "", "identity"), "artifact_encoding_rejected")
            content_type = response.headers.get("Content-Type")
            require(
                isinstance(content_type, str)
                and content_type.split(";", 1)[0].strip().lower() == expected_content_type,
                "artifact_content_type_mismatch",
            )
            content_length = response.headers.get("Content-Length")
            if content_length is not None:
                require(content_length.isdigit(), "artifact_length_invalid")
                require(int(content_length) == expected_bytes, "artifact_length_mismatch")
            digest = hashlib.sha256()
            received = 0
            captured = bytearray() if capture else None
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                received += len(chunk)
                require(received <= expected_bytes, "artifact_size_mismatch")
                digest.update(chunk)
                if captured is not None:
                    captured.extend(chunk)
            require(received == expected_bytes, "artifact_size_mismatch")
            return digest.hexdigest(), received, bytes(captured) if captured is not None else None
        except (TimeoutError, HTTPException, OSError) as exc:
            raise SmokeFailure("artifact_transport_failed") from exc
        finally:
            response.close()


def _header(headers: Mapping[str, str], name: str) -> Optional[str]:
    lower = name.lower()
    return next((value for key, value in headers.items() if key.lower() == lower), None)


def _json_object(payload: bytes) -> Mapping[str, Any]:
    try:
        value = decode_json_document(payload, max_bytes=MAX_JSON_RESPONSE_BYTES)
    except ContractValidationError as exc:
        raise SmokeFailure("response_json_invalid") from exc
    require(isinstance(value, Mapping), "response_json_invalid")
    return value


def _response_integer(value: Any, *, minimum: int, maximum: int, code: str) -> int:
    require(
        not isinstance(value, bool) and isinstance(value, (int, Decimal)),
        code,
    )
    number = Decimal(value)
    require(number == number.to_integral_value(), code)
    result = int(number)
    require(minimum <= result <= maximum, code)
    return result


def _problem_code(payload: bytes) -> str:
    document = _json_object(payload)
    require(set(document) == {"error"}, "error_envelope_invalid")
    error = document.get("error")
    require(isinstance(error, Mapping), "error_envelope_invalid")
    code = error.get("code")
    require(isinstance(code, str), "error_envelope_invalid")
    return code


def _validate_build_document(
    document: Mapping[str, Any],
    *,
    request_sha256: str,
    spec_sha256: str,
    expected_build_id: Optional[str] = None,
) -> str:
    require(set(document) == BUILD_DOCUMENT_FIELDS, "build_document_invalid")
    build_id = document.get("build_id")
    require(isinstance(build_id, str), "build_document_invalid")
    try:
        require(str(UUID(build_id)) == build_id, "build_document_invalid")
    except (ValueError, AttributeError) as exc:
        raise SmokeFailure("build_document_invalid") from exc
    if expected_build_id is not None:
        require(build_id == expected_build_id, "build_id_changed")
    require(document.get("request_sha256") == request_sha256, "request_provenance_mismatch")
    require(document.get("spec_sha256") == spec_sha256, "spec_provenance_mismatch")
    status = document.get("status")
    require(status in BUILD_STATUSES, "build_status_invalid")
    _response_integer(
        document.get("state_version"), minimum=0, maximum=(1 << 63) - 1, code="build_document_invalid"
    )
    _response_integer(document.get("max_attempts"), minimum=1, maximum=100, code="build_document_invalid")
    for field in ("created_at", "updated_at"):
        value = document.get(field)
        require(
            isinstance(value, str) and UTC_TIMESTAMP_PATTERN.fullmatch(value) is not None,
            "build_document_invalid",
        )
    if status == "succeeded":
        require(document.get("terminal_code") is None, "build_document_invalid")
        require(
            isinstance(document.get("manifest_sha256"), str)
            and SHA256_PATTERN.fullmatch(str(document["manifest_sha256"])) is not None,
            "build_document_invalid",
        )
        _response_integer(
            document.get("manifest_bytes"),
            minimum=1,
            maximum=MAX_JSON_RESPONSE_BYTES,
            code="build_document_invalid",
        )
        for field in ("finished_at", "published_at"):
            value = document.get(field)
            require(
                isinstance(value, str) and UTC_TIMESTAMP_PATTERN.fullmatch(value) is not None,
                "build_document_invalid",
            )
        require(
            document.get("artifacts_url") == f"/v1/builds/{build_id}/artifacts",
            "build_document_invalid",
        )
    elif status not in TERMINAL_STATUSES:
        require(document.get("manifest_sha256") is None, "build_document_invalid")
        require(document.get("manifest_bytes") is None, "build_document_invalid")
        require(document.get("finished_at") is None, "build_document_invalid")
        require(document.get("published_at") is None, "build_document_invalid")
        require(document.get("artifacts_url") is None, "build_document_invalid")
    return build_id


class ApiClient:
    def __init__(
        self,
        origin: Origin,
        transport: HttpTransport,
        *,
        timeout: float,
    ) -> None:
        self.origin = origin
        self.transport = transport
        self.timeout = timeout

    def request(
        self,
        method: str,
        path: str,
        *,
        token: Optional[str] = None,
        body: Optional[bytes] = None,
        headers: Optional[Mapping[str, str]] = None,
    ) -> tuple[int, Mapping[str, str], bytes]:
        require(path.startswith("/") and not path.startswith("//"), "api_path_rejected")
        require("?" not in path and "#" not in path, "api_path_rejected")
        request_headers = {"Accept": "application/json", **dict(headers or {})}
        if token is not None:
            request_headers["Authorization"] = "Bearer " + token
        return self.transport.request(
            self.origin.base_url + path,
            method,
            headers=request_headers,
            body=body,
            timeout=self.timeout,
        )


def _different_valid_token(token: str) -> str:
    replacement = "A" if token[0] != "A" else "B"
    return replacement + token[1:]


def _load_request(path: Path) -> tuple[bytes, Any]:
    try:
        payload = path.read_bytes()
    except OSError as exc:
        raise SmokeFailure("bundled_request_unavailable") from exc
    require(len(payload) <= MAX_BUILD_REQUEST_BYTES, "bundled_request_invalid")
    try:
        return payload, validate_build_request(payload)
    except ContractValidationError as exc:
        raise SmokeFailure("bundled_request_invalid") from exc


def _submit(
    client: ApiClient,
    *,
    token: str,
    payload: bytes,
    key: str,
) -> tuple[int, Mapping[str, str], Mapping[str, Any]]:
    status, headers, response = client.request(
        "POST",
        "/v1/builds",
        token=token,
        body=payload,
        headers={"Content-Type": "application/json", "Idempotency-Key": key},
    )
    return status, headers, _json_object(response)


def _validate_artifact_listing(
    document: Mapping[str, Any],
    *,
    build_id: str,
    published_at: str,
) -> tuple[list[Mapping[str, Any]], int]:
    require(set(document) == ARTIFACT_DOCUMENT_FIELDS, "artifact_document_invalid")
    require(document.get("build_id") == build_id, "artifact_build_id_mismatch")
    require(document.get("published_at") == published_at, "artifact_publication_mismatch")
    expires = _response_integer(
        document.get("expires_in_seconds"),
        minimum=30,
        maximum=900,
        code="artifact_document_invalid",
    )
    entries = document.get("artifacts")
    require(isinstance(entries, list), "artifact_document_invalid")
    require(len(entries) == len(REQUIRED_PUBLISHED_ARTIFACTS), "artifact_allowlist_mismatch")
    normalized: list[Mapping[str, Any]] = []
    for expected_path, entry in zip(REQUIRED_PUBLISHED_ARTIFACTS, entries):
        require(isinstance(entry, Mapping), "artifact_entry_invalid")
        require(set(entry) == ARTIFACT_ENTRY_FIELDS, "artifact_entry_invalid")
        require(entry.get("path") == expected_path, "artifact_allowlist_mismatch")
        require(
            entry.get("content_type") == ARTIFACT_CONTENT_TYPES[expected_path],
            "artifact_content_type_mismatch",
        )
        size = _response_integer(
            entry.get("bytes"),
            minimum=1,
            maximum=MAX_PUBLISHED_BYTES,
            code="artifact_size_invalid",
        )
        digest = entry.get("sha256")
        require(isinstance(digest, str) and SHA256_PATTERN.fullmatch(digest) is not None, "artifact_hash_invalid")
        require(isinstance(entry.get("download_url"), str), "signed_url_rejected")
        normalized.append(entry)
    require(
        sum(int(entry["bytes"]) for entry in normalized) <= MAX_PUBLISHED_BYTES,
        "artifact_budget_exceeded",
    )
    return normalized, expires


def _qa_agrees(manifest: BuildManifest, quality: QualityReport, request: Any) -> bool:
    measurements = quality.measurements
    checks = quality.checks
    return (
        quality.status == "passed"
        and quality.measurements["requested_height_mm"] == request.spec.height_mm
        and quality.measurements["dimensions_mm"] == manifest.dimensions_mm
        and manifest.qa["status"] == quality.status
        and manifest.qa["manifold"] == checks["manifold"]
        and manifest.qa["non_manifold_edges"] == measurements["non_manifold_edges"]
        and manifest.qa["minimum_wall_mm"] == measurements["minimum_wall_mm"]
        and manifest.qa["minimum_feature_mm"] == measurements["minimum_feature_mm"]
        and manifest.qa["connected_shells"] == measurements["connected_shells"]
        and manifest.qa["positive_volume"] == checks["positive_volume"]
        and manifest.qa["fresh_reload"] == checks["fresh_reload"]
        and manifest.qa["glb_reimport"] == checks["glb_reimport"]
        and manifest.qa["stl_reimport"] == checks["stl_reimport"]
    )


def execute_smoke(
    *,
    target_origin: Origin,
    token: str,
    allowed_artifact_origins: frozenset[Origin],
    poll_timeout: float,
    poll_interval: float,
    request_timeout: float,
    transport: Optional[HttpTransport] = None,
    clock: Callable[[], float] = time.monotonic,
    sleep: Callable[[float], None] = time.sleep,
) -> Mapping[str, Any]:
    require(0 < poll_timeout <= MAX_POLL_SECONDS, "poll_timeout_invalid")
    require(0 < poll_interval <= MAX_POLL_INTERVAL_SECONDS, "poll_interval_invalid")
    require(0 < request_timeout <= MAX_REQUEST_TIMEOUT_SECONDS, "request_timeout_invalid")
    client = ApiClient(target_origin, transport or HttpTransport(), timeout=request_timeout)
    facet_payload, facet = _load_request(ROOT / "examples" / "requests" / "facet-bot.json")
    moss_payload, moss = _load_request(ROOT / "examples" / "requests" / "moss-hopper.json")
    require(facet.request_sha256 != moss.request_sha256, "bundled_request_invalid")

    status, _headers, payload = client.request("GET", "/healthz")
    require(status == 200 and _json_object(payload) == {"status": "ok"}, "health_check_failed")

    # The VPS edge intentionally does not route readiness at all.  Check all
    # credential variants so the public result cannot reveal dependency state.
    readiness_observations = []
    for readiness_token in (None, _different_valid_token(token), token):
        status, headers, payload = client.request("GET", "/readyz", token=readiness_token)
        require(status == 404, "ready_endpoint_exposed")
        require(_header(headers, "WWW-Authenticate") is None, "ready_endpoint_exposed")
        readiness_observations.append((_header(headers, "Content-Type"), payload))
    require(
        readiness_observations[0] == readiness_observations[1] == readiness_observations[2],
        "ready_endpoint_disclosure",
    )

    idempotency_key = "g8-operator-" + uuid4().hex
    auth_probe_key = "g8-auth-probe-" + uuid4().hex
    status, headers, payload = client.request(
        "POST",
        "/v1/builds",
        body=facet_payload,
        headers={"Content-Type": "application/json", "Idempotency-Key": auth_probe_key},
    )
    require(status == 401 and _problem_code(payload) == "unauthorized", "api_auth_boundary_failed")
    require(_header(headers, "WWW-Authenticate") == "Bearer", "api_auth_boundary_failed")
    status, _headers, payload = client.request(
        "POST",
        "/v1/builds",
        token=_different_valid_token(token),
        body=facet_payload,
        headers={"Content-Type": "application/json", "Idempotency-Key": auth_probe_key},
    )
    require(status == 401 and _problem_code(payload) == "unauthorized", "api_auth_boundary_failed")

    submit_started = clock()
    status, headers, created = _submit(
        client,
        token=token,
        payload=facet_payload,
        key=idempotency_key,
    )
    submit_elapsed = clock() - submit_started
    require(status == 202, "asynchronous_submit_failed")
    require(submit_elapsed < 10.0, "asynchronous_submit_slow")
    build_id = _validate_build_document(
        created,
        request_sha256=facet.request_sha256,
        spec_sha256=facet.spec_sha256,
    )
    require(_header(headers, "Location") == f"/v1/builds/{build_id}", "build_location_invalid")

    status, replay_headers, replay = _submit(
        client,
        token=token,
        payload=facet_payload,
        key=idempotency_key,
    )
    require(status == 200, "idempotency_replay_failed")
    _validate_build_document(
        replay,
        request_sha256=facet.request_sha256,
        spec_sha256=facet.spec_sha256,
        expected_build_id=build_id,
    )
    require(
        _header(replay_headers, "Location") == f"/v1/builds/{build_id}",
        "build_location_invalid",
    )

    conflict_status, _conflict_headers, conflict = _submit(
        client,
        token=token,
        payload=moss_payload,
        key=idempotency_key,
    )
    require(
        conflict_status == 409 and _problem_code(canonical_json_bytes(conflict)) == "idempotency_conflict",
        "idempotency_conflict_failed",
    )

    deadline = clock() + poll_timeout
    poll_limit = min(MAX_POLL_REQUESTS, math.ceil(poll_timeout / poll_interval) + 1)
    final: Optional[Mapping[str, Any]] = None
    for _poll in range(poll_limit):
        if clock() >= deadline:
            break
        status, _headers, payload = client.request(
            "GET", f"/v1/builds/{build_id}", token=token
        )
        require(status == 200, "build_poll_failed")
        document = _json_object(payload)
        _validate_build_document(
            document,
            request_sha256=facet.request_sha256,
            spec_sha256=facet.spec_sha256,
            expected_build_id=build_id,
        )
        state = document["status"]
        if state in TERMINAL_STATUSES:
            final = document
            break
        sleep(min(poll_interval, max(0.0, deadline - clock())))
    require(final is not None, "build_poll_timeout")
    require(final["status"] == "succeeded", "build_terminal_failure")

    status, _headers, payload = client.request(
        "GET", f"/v1/builds/{build_id}/artifacts", token=token
    )
    require(status == 200, "artifact_listing_failed")
    entries, signed_url_ttl = _validate_artifact_listing(
        _json_object(payload),
        build_id=build_id,
        published_at=str(final["published_at"]),
    )

    metadata = {str(entry["path"]): entry for entry in entries}
    validated_urls = {}
    for entry in entries:
        path = str(entry["path"])
        if path in ("qa.json", "manifest.json"):
            require(int(entry["bytes"]) <= MAX_JSON_RESPONSE_BYTES, "artifact_contract_too_large")
        validated_urls[path] = validate_signed_download_url(
            str(entry["download_url"]),
            target_origin=target_origin,
            allowed_artifact_origins=allowed_artifact_origins,
            expires_in_seconds=signed_url_ttl,
        )

    captured: dict[str, bytes] = {}
    artifact_total = 0

    def fetch(path: str, *, capture: bool) -> Optional[bytes]:
        nonlocal artifact_total
        entry = metadata[path]
        digest, received, body = client.transport.download(
            validated_urls[path],
            expected_bytes=int(entry["bytes"]),
            expected_content_type=str(entry["content_type"]),
            timeout=request_timeout,
            capture=capture,
        )
        require(digest == entry["sha256"], "artifact_hash_mismatch")
        artifact_total += received
        require(artifact_total <= MAX_PUBLISHED_BYTES, "artifact_budget_exceeded")
        if capture:
            require(body is not None and len(body) <= MAX_JSON_RESPONSE_BYTES, "artifact_contract_too_large")
            captured[path] = body
        return body

    # Validate the small contracts and all remote URLs before transferring the
    # potentially large model/render artifacts.
    manifest_payload = fetch("manifest.json", capture=True)
    qa_payload = fetch("qa.json", capture=True)
    require(manifest_payload is not None and qa_payload is not None, "artifact_contract_missing")
    try:
        manifest = validate_manifest(manifest_payload)
        quality = validate_quality_report(qa_payload)
    except ContractValidationError as exc:
        raise SmokeFailure("artifact_contract_invalid") from exc
    require(manifest_payload == manifest.canonical_bytes + b"\n", "manifest_not_canonical")
    require(qa_payload == quality.canonical_bytes + b"\n", "qa_not_canonical")
    require(manifest.request_sha256 == facet.request_sha256, "request_provenance_mismatch")
    require(manifest.spec_sha256 == facet.spec_sha256, "spec_provenance_mismatch")
    require(_qa_agrees(manifest, quality, facet), "qa_manifest_mismatch")
    for path in manifest.artifacts:
        require(path in metadata, "artifact_allowlist_mismatch")
        require(
            int(metadata[path]["bytes"]) == int(manifest.artifacts[path]["bytes"])
            and metadata[path]["sha256"] == manifest.artifacts[path]["sha256"],
            "manifest_artifact_mismatch",
        )
    manifest_entry = metadata["manifest.json"]
    require(final["manifest_bytes"] == manifest_entry["bytes"], "manifest_publication_mismatch")
    require(final["manifest_sha256"] == manifest_entry["sha256"], "manifest_publication_mismatch")

    for path in REQUIRED_PUBLISHED_ARTIFACTS:
        if path not in ("qa.json", "manifest.json"):
            fetch(path, capture=False)

    return {
        "artifact_bytes": artifact_total,
        "artifact_count": len(entries),
        "build_id": build_id,
        "checks": [
            "health",
            "private_readiness",
            "api_authentication",
            "asynchronous_submit",
            "idempotency_replay",
            "idempotency_conflict",
            "bounded_polling",
            "artifact_allowlist",
            "signed_download_origin",
            "artifact_hashes",
            "manifest_contract",
        ],
        "evidence_version": "operator-smoke/v1",
        "gate": "G8_OPERATOR_SMOKE",
        "manifest_sha256": manifest_entry["sha256"],
        "request_sha256": facet.request_sha256,
        "result": "PASS",
        "spec_sha256": facet.spec_sha256,
        "submit_milliseconds": round(submit_elapsed * 1000),
        "tested_at": _utc_timestamp(),
    }


def atomic_write_evidence(path: Path, document: Mapping[str, Any]) -> None:
    payload = canonical_json_bytes(document) + b"\n"
    try:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        temporary = path.parent / f".{path.name}.{os.getpid()}.{uuid4().hex}.tmp"
        flags = (
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
        )
        descriptor = os.open(temporary, flags, 0o600)
        try:
            os.fchmod(descriptor, 0o600)
            offset = 0
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                require(written > 0, "evidence_write_failed")
                offset += written
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, path)
        metadata = path.lstat()
        require(stat.S_ISREG(metadata.st_mode), "evidence_write_failed")
        require(stat.S_IMODE(metadata.st_mode) == 0o600, "evidence_write_failed")
        directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except SmokeFailure:
        raise
    except OSError as exc:
        raise SmokeFailure("evidence_write_failed") from exc
    finally:
        try:
            if "temporary" in locals() and temporary.exists():
                temporary.unlink()
        except OSError:
            pass


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Run the bounded G8 operator smoke against an explicitly authorized target."
    )
    parser.add_argument("--target", help="API root URL; HTTPS is required for non-loopback hosts")
    parser.add_argument("--token-file", type=Path, help="mode-0600 file containing one service token")
    parser.add_argument(
        "--allow-loopback-http",
        action="store_true",
        help="permit HTTP only when --target uses literal loopback or localhost",
    )
    parser.add_argument(
        "--allow-artifact-host",
        action="append",
        default=[],
        metavar="HOST[:PORT]",
        help="explicit cross-origin HTTPS artifact authority; repeat as needed",
    )
    parser.add_argument("--evidence", type=Path, help="atomically write sanitized mode-0600 JSON evidence")
    parser.add_argument("--poll-timeout", type=float, default=1200.0)
    parser.add_argument("--poll-interval", type=float, default=2.0)
    parser.add_argument("--request-timeout", type=float, default=30.0)
    return parser


def _write_failure_evidence(path: Optional[Path], code: str) -> None:
    if path is None:
        return
    atomic_write_evidence(
        path,
        {
            "evidence_version": "operator-smoke/v1",
            "failure_code": code,
            "gate": "G8_OPERATOR_SMOKE",
            "result": "FAIL",
            "tested_at": _utc_timestamp(),
        },
    )


def main(argv: Optional[Iterable[str]] = None) -> int:
    arguments = _parser().parse_args(list(argv) if argv is not None else None)
    if arguments.target is None:
        evidence = {
            "evidence_version": "operator-smoke/v1",
            "gate": "G8_OPERATOR_SMOKE",
            "reason": "no_target",
            "result": "CONDITIONAL_SKIP",
            "tested_at": _utc_timestamp(),
        }
        try:
            if arguments.evidence is not None:
                atomic_write_evidence(arguments.evidence, evidence)
        except SmokeFailure:
            print("OPERATOR_SMOKE: FAIL code=evidence_write_failed", file=sys.stderr)
            return 1
        print("OPERATOR_SMOKE: CONDITIONAL_SKIP reason=no_target")
        return 0

    try:
        require(arguments.token_file is not None, "token_file_required")
        target_origin = validate_target_url(
            arguments.target,
            allow_loopback_http=bool(arguments.allow_loopback_http),
        )
        allowed = frozenset(parse_artifact_host(value) for value in arguments.allow_artifact_host)
        token = read_token_file(arguments.token_file)
        evidence = execute_smoke(
            target_origin=target_origin,
            token=token,
            allowed_artifact_origins=allowed,
            poll_timeout=arguments.poll_timeout,
            poll_interval=arguments.poll_interval,
            request_timeout=arguments.request_timeout,
        )
        if arguments.evidence is not None:
            atomic_write_evidence(arguments.evidence, evidence)
    except SmokeFailure as exc:
        try:
            _write_failure_evidence(arguments.evidence, exc.code)
        except SmokeFailure:
            pass
        print(f"OPERATOR_SMOKE: FAIL code={exc.code}", file=sys.stderr)
        return 1
    except Exception:
        try:
            _write_failure_evidence(arguments.evidence, "unexpected_error")
        except SmokeFailure:
            pass
        print("OPERATOR_SMOKE: FAIL code=unexpected_error", file=sys.stderr)
        return 1

    print(
        "OPERATOR_SMOKE: PASS "
        f"build_id={evidence['build_id']} artifacts={evidence['artifact_count']} "
        f"bytes={evidence['artifact_bytes']}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Make a native, unsigned, read-only developer preview. This command does not publish files."""
from __future__ import annotations

import argparse
import ast
import importlib.metadata
import importlib.util
import json
import os
from pathlib import Path
import platform
import re
import shutil
import signal
import subprocess
import sys
import sysconfig
import tarfile
import zipfile

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from experimental_modeling.preview_manifest import MANIFEST, inventory, sha256, verify

WINDOWS_HELPER_SPEC = importlib.util.spec_from_file_location(
    "windows_preview_launcher_build", ROOT / "packaging/windows_preview_launcher.py")
windows_launcher = importlib.util.module_from_spec(WINDOWS_HELPER_SPEC)
WINDOWS_HELPER_SPEC.loader.exec_module(windows_launcher)

NAME = "hbcb-review-preview"
PYTHON_VERSION = "3.13.16"
PYINSTALLER_VERSION = "6.22.3"
MACOS_SEAL_CODE = ("from PyInstaller.utils.osx import sign_binary; import sys; "
                  "sign_binary(sys.argv[1], identity=None, entitlements_file=None, deep=False)")
EXCLUDES = ["experimental_modeling.sandbox", "experimental_modeling.inspect_scene", "bpy",
            "tkinter", "_tkinter", "idlelib", "test", "unittest", "ensurepip", "pip",
            "setuptools", "sqlite3", "_sqlite3", "curses", "_curses", "readline",
            "ssl", "_ssl", "_hashlib", "_bz2", "_lzma", "ctypes", "_ctypes"]
LIBMPDEC_VERSIONS = {"windows-x64": "4.0.0", "macos-arm64": "4.0.1"}


def decimal_notices(target):
    notices = ["licenses/CPython-LICENSE.txt", "licenses/CPython-incorporated-software.rst",
               "licenses/CPython-decimal-libmpdec-NOTICES.txt"]
    if target in LIBMPDEC_VERSIONS:
        notices.append(f"licenses/CPython-libmpdec-{LIBMPDEC_VERSIONS[target]}-NOTICES.txt")
    return notices


def decimal_component(target):
    import _decimal

    version = _decimal.__libmpdec_version__
    expected = LIBMPDEC_VERSIONS.get(target)
    if expected is not None and version != expected:
        raise ValueError(f"Unreviewed libmpdec version for {target}: {version}; expected {expected}")
    return {"component": "libmpdec in CPython _decimal", "version": version,
            "applicable": expected is not None,
            "incorporation": ("Static, as selected by the reviewed CPython target build" if expected else
                              "Local validation only; static incorporation and source identity are not asserted"),
            "license_files": decimal_notices(target) if expected else [],
            "notice_catalog": "licenses/sources.json",
            "notice_catalog_entry": (f"CPython-libmpdec-{expected}-NOTICES.txt" if expected else None)}


def bind_decimal_component(component, native, target):
    matches = [row for row in native if Path(row["file"]).name.lower().startswith("_decimal.")]
    origin = "extension"
    if not matches and target == "linux-validation":
        import _decimal

        spec = importlib.util.find_spec("_decimal")
        if ("_decimal" in sys.builtin_module_names and spec is not None and spec.origin == "built-in"
                and getattr(_decimal, "__file__", None) is None):
            matches = [row for row in native if row["bundled"] and row["component"] == "CPython"
                       and re.fullmatch(r"libpython[0-9].*\.so(?:\..*)?", Path(row["file"]).name.lower())]
            origin = "built-in; local validation only, source identity unverified"
    if len(matches) != 1:
        raise ValueError("The preview must include the _decimal native module used by fractions.Fraction; "
                         "a verified Linux built-in requires one bundled libpython")
    return {**component, "native_file": matches[0]["file"], "native_sha256": matches[0]["sha256"],
            "runtime_module_origin": origin}


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, timeout=30).decode().strip()


def write_json(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def dependencies():
    expected = {"pyinstaller": PYINSTALLER_VERSION, "pyinstaller-hooks-contrib": "2026.8",
                "altgraph": "0.17.5", "packaging": "26.3", "setuptools": "84.0.0"}
    if sys.platform == "win32":
        expected.update({"pefile": "2024.8.26", "pywin32-ctypes": "0.2.3"})
    if sys.platform == "darwin":
        expected["macholib"] = "1.16.4"
    for name, version in expected.items():
        if importlib.metadata.version(name) != version:
            raise ValueError(f"Build dependency differs from the reviewed lock: {name}")
    return expected


def collect_notices(bundle):
    destination = bundle / "licenses"
    destination.mkdir()
    shutil.copy2(ROOT / "LICENSE", destination / "HBCB-GPL-3.0.txt")
    catalog = json.loads((ROOT / "packaging/runtime-notices.json").read_text())
    for row in catalog["notices"]:
        source = ROOT / "packaging/notices" / row["file"]
        if sha256(source) != row["sha256"]:
            raise ValueError("Reviewed upstream notice hash changed")
        shutil.copy2(source, destination / row["file"])
    # Preserve the installed runtime's own license in addition to source notices.
    candidates = [Path(sys.base_prefix) / name for name in ("LICENSE.txt", "LICENSE", "Resources/LICENSE.txt")]
    candidates += [Path(sysconfig.get_path("stdlib")) / "LICENSE.txt"]
    found = next((path for path in candidates if path.is_file()), None)
    if found:
        shutil.copy2(found, destination / "Installed-Python-LICENSE.txt")
    elif sys.platform in {"win32", "darwin"}:
        raise ValueError("Installed official Python runtime license was not found")
    # Preserve exact build-tool notices as a separately named provenance set.
    for name in dependencies():
        dist = importlib.metadata.distribution(name)
        for item in dist.files or []:
            if ".dist-info/" in item.as_posix() and any(part.lower().startswith(("license", "copying", "notice")) for part in item.parts):
                source = Path(dist.locate_file(item))
                if source.is_file():
                    if item.is_absolute() or ".." in item.parts:
                        raise ValueError("Build-tool notice must have a normal package-relative path")
                    # Vendored dependencies often repeat LICENSE basenames.
                    # Keep the full metadata path so none silently overwrite.
                    target = destination / "build-tools" / name / Path(*item.parts)
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(source, target)
    shutil.copy2(ROOT / "packaging/runtime-notices.json", destination / "sources.json")
    return catalog


def checked_macos_command(command, timeout):
    # Keep the helper and its codesign child in one owned process group.
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               start_new_session=True)
    try:
        stdout, stderr = process.communicate(timeout=timeout)
        if process.returncode:
            raise subprocess.CalledProcessError(process.returncode, command, output=stdout, stderr=stderr)
    except BaseException as error:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass  # The owned process group already exited.
        stdout, stderr = process.communicate()  # Reap only after the group stops.
        if isinstance(error, (subprocess.CalledProcessError, subprocess.TimeoutExpired)):
            for name, value in (("stdout", stdout), ("stderr", stderr)):
                value = value or getattr(error, name, None) or ""
                if isinstance(value, bytes):
                    value = value.decode("utf-8", errors="replace")
                error.add_note(f"{name} (last 4096 characters): {value[-4096:]}")
        raise
    return {"returncode": process.returncode, "stdout": stdout[-4096:], "stderr": stderr[-4096:],
            "stdout_truncated": len(stdout) > 4096, "stderr_truncated": len(stderr) > 4096}


def seal_macos_framework(bundle, target):
    """Seal the collected framework before package hashes. This does not establish OS trust."""
    if target != "macos-arm64":
        return None
    if sys.platform != "darwin":
        raise ValueError("Framework sealing must run on macOS")
    if importlib.metadata.version("pyinstaller") != PYINSTALLER_VERSION:
        raise ValueError("Framework sealing requires the reviewed PyInstaller version")
    if bundle.is_symlink():
        raise ValueError("The build bundle must not be a symlink")
    bundle = bundle.resolve(strict=True)
    if any((bundle / name).exists() for name in (MANIFEST, "provenance.json", "source")):
        raise ValueError("Seal only new build output before package metadata and source archives")

    # PyInstaller signs cached Mach-O files before COLLECT restores the framework.
    # Seal the complete framework with the same pinned vendor helper.
    # https://github.com/pyinstaller/pyinstaller/blob/v6.22.3/PyInstaller/utils/osx.py
    framework = bundle / "_internal/Python.framework"
    version = framework / "Versions" / ".".join(PYTHON_VERSION.split(".")[:2])
    directories = [bundle / "_internal", framework, framework / "Versions", version, version / "Resources"]
    files = [version / "Python", version / "Resources/Info.plist", bundle / NAME]
    for path in directories + files:
        if path.is_symlink() or not path.resolve(strict=True).is_relative_to(bundle):
            raise ValueError("Framework sealing paths must stay in the new build bundle")
        if not (path.is_dir() if path in directories else path.is_file()):
            raise ValueError(f"Missing framework sealing input: {path.relative_to(bundle)}")
        if path in files and path.stat().st_nlink != 1:
            raise ValueError("Framework sealing inputs must not have hardlinks")
    links = {framework / "Python": "Versions/Current/Python",
             framework / "Resources": "Versions/Current/Resources",
             framework / "Versions/Current": version.name}
    for path, destination in links.items():
        if not path.is_symlink() or os.readlink(path) != destination:
            raise ValueError("The Python framework must have the reviewed internal links")
    expected = set(directories[1:] + files[:2] + list(links))
    if set(framework.rglob("*")) | {framework} != expected:
        raise ValueError("The Python framework layout differs from the reviewed build input")
    if set(bundle.rglob("*.framework")) != {framework}:
        raise ValueError("The preview must contain only the reviewed Python framework")

    # No identity, entitlements, or recursive signing. Never sign the whole output.
    # The child uses this interpreter and its pinned vendor helper. Bound its runtime.
    signing = checked_macos_command([sys.executable, "-I", "-c", MACOS_SEAL_CODE, str(framework)], timeout=60)
    seal = version / "_CodeSignature/CodeResources"
    if (seal.parent.is_symlink() or seal.is_symlink() or not seal.is_file()
            or not seal.resolve(strict=True).is_relative_to(framework) or seal.stat().st_size == 0):
        raise ValueError("Framework signing did not produce a resource seal")
    checks = []
    for path in (framework, version / "Python", bundle / NAME):
        command = ["/usr/bin/codesign", "--verify", "--strict", "--verbose=4", str(path)]
        result = checked_macos_command(command, timeout=30)
        checks.append({"file": path.relative_to(bundle).as_posix(), **result,
                       "command": command[:-1] + [path.relative_to(bundle).as_posix()]})
    return {"scope": "New build output only. No publisher signature or notarization. OS trust is not tested.",
            "framework": framework.relative_to(bundle).as_posix(),
            "helper": "PyInstaller.utils.osx.sign_binary", "pyinstaller_version": PYINSTALLER_VERSION,
            "identity": "ad-hoc", "entitlements": None, "deep": False,
            "signing": signing,
            "resource_seal": {"file": seal.relative_to(bundle).as_posix(), "sha256": sha256(seal)},
            "strict_verification": checks}


def native_inventory(bundle, work, target):
    # Record original analysis inputs before removing Microsoft runtime files.
    analysis = ast.literal_eval((work / NAME / "Analysis-00.toc").read_text(encoding="utf-8"))
    inputs = {}
    for value in analysis:
        if isinstance(value, list):
            for entry in value:
                if isinstance(entry, tuple) and len(entry) == 3 and entry[2] in {"BINARY", "EXTENSION"}:
                    inputs[Path(entry[0]).name.lower()] = entry[1]
    excluded = []
    for path in sorted(bundle.rglob("*")):
        runtime = re.fullmatch(r"(?:vcruntime|msvcp|concrt|ucrtbase)[a-z0-9_]*\.dll", path.name, re.I)
        api_set = re.fullmatch(r"(?:api|ext)-ms-win-[a-z0-9-]+\.dll", path.name, re.I)
        if target == "windows-x64" and path.is_file() and not path.is_symlink() and (runtime or api_set):
            # Microsoft documents API-set contract resolution as an OS-loader
            # facility on current Windows. Do not redistribute collected stubs.
            # https://learn.microsoft.com/en-us/windows/win32/apiindex/api-set-loader-operation
            excluded.append({"name": path.name, "sha256": sha256(path), "bundled": False,
                             "analysis_source": inputs.get(path.name.lower()),
                             "reason": ("OS-provided Windows API-set contract; do not redistribute stubs" if api_set else
                                        "Use the existing Microsoft runtime; no redistribution rights assumed")})
            path.unlink()
    rows = []
    unmapped = []
    for path in sorted(bundle.rglob("*")):
        if path.is_symlink() or not path.is_file():
            continue
        name = path.name.lower()
        if not (name.endswith((".exe", ".dll", ".pyd", ".dylib", ".so")) or ".so." in name or name in {"python", "python3"}):
            continue
        source = inputs.get(name)
        if any(x in name for x in ("libssl", "libcrypto", "libffi", "libbz2", "liblzma")):
            raise ValueError(f"Unused external native library entered the preview: {name}")
        # Reviewed target builds incorporate libmpdec into _decimal.
        # A separate library needs its own source and notice review.
        if name.startswith(("libmpdec", "mpdec")) and target != "linux-validation":
            unmapped.append({"name": name, "sha256": sha256(path), "analysis_source": source})
            continue
        if name.endswith(".exe"):
            if target != "windows-x64" or path.parent != bundle or name not in {
                    windows_launcher.PUBLIC_NAME, windows_launcher.PAYLOAD_NAME}:
                unmapped.append({"name": name, "sha256": sha256(path), "analysis_source": source})
                continue
            if name == windows_launcher.PUBLIC_NAME:
                component, notices = "HBCB Windows OS-only launcher", ["licenses/HBCB-GPL-3.0.txt"]
                source = "packaging/windows_preview_launcher.c (matching corresponding source)"
            else:
                component = "PyInstaller frozen payload and Windows bootloader with zlib"
                notices = ["licenses/HBCB-GPL-3.0.txt", "licenses/PyInstaller-COPYING.txt",
                           "licenses/PyInstaller-zlib-LICENSE.txt"]
                source = "Pinned PyInstaller bootloader plus matching project source; build provenance records inputs"
        elif name.startswith("libz."):
            component, notices = "zlib", ["licenses/zlib-LICENSE.txt"]
        elif name.startswith("_decimal."):
            if target in LIBMPDEC_VERSIONS:
                component = f"CPython _decimal with static libmpdec {LIBMPDEC_VERSIONS[target]}"
                notices = decimal_notices(target)
            else:
                component, notices = "Local Linux validation _decimal/libmpdec (not a distributed target)", []
        elif name.endswith(".pyd") or ".cpython-" in name or name.startswith(("libpython", "python3")) or name == "python":
            component, notices = "CPython", ["licenses/CPython-LICENSE.txt", "licenses/CPython-incorporated-software.rst"]
            # Static incorporated code is invisible to dynamic-library scans.
            if name.startswith(("_md5", "_sha", "python3", "libpython")) or name == "python":
                notices += ["licenses/CPython-hacl-NOTICES.txt", "licenses/Apache-2.0.txt"]
            if name.startswith(("_blake2", "python3", "libpython")) or name == "python":
                notices += ["licenses/CPython-blake2-NOTICES.txt", "licenses/CC0-1.0.txt"]
            if name.startswith(("pyexpat", "python3", "libpython")) or name == "python":
                notices += ["licenses/CPython-expat-COPYING.txt", "licenses/zlib-LICENSE.txt"]
        elif target == "linux-validation":
            component, notices = "Local Linux validation dependency (not a distributed target)", []
        else:
            unmapped.append({"name": name, "sha256": sha256(path), "analysis_source": source})
            continue
        rows.append({"file": path.relative_to(bundle).as_posix(), "sha256": sha256(path),
                     "component": component, "license_files": notices,
                     "analysis_source": source, "bundled": True})
    if unmapped:
        write_json(work.parent / "native-review-needed.json", {"unmapped": unmapped, "excluded": excluded})
        raise ValueError("Unmapped native components; inspect provenance and licenses before distribution: " +
                         ", ".join(row["name"] for row in unmapped))
    return rows, excluded


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True, help="Select a new or empty build output folder.")
    parser.add_argument("--target", choices=["windows-x64", "macos-arm64", "linux-validation"], required=True)
    args = parser.parse_args()
    systems = {"windows-x64": ("Windows", {"amd64", "x86_64"}),
               "macos-arm64": ("Darwin", {"arm64", "aarch64"}),
               "linux-validation": ("Linux", {"x86_64", "amd64"})}
    system, machines = systems[args.target]
    if platform.system() != system or platform.machine().lower() not in machines:
        raise ValueError('Build must run natively on the stated OS and CPU. No cross-compilation evidence')
    if args.target != "linux-validation" and platform.python_version() != PYTHON_VERSION:
        raise ValueError(f"Use the pinned official CPython {PYTHON_VERSION} standard-GIL runtime")
    if sysconfig.get_config_var("Py_GIL_DISABLED"):
        raise ValueError("Free-threaded Python is not a reviewed preview input")
    if git("diff", "--name-only"):
        raise ValueError('Stage the reviewed source first. Working tree must match the Git index')
    tree = git("write-tree")
    commit = git("rev-parse", "HEAD")
    clean = tree == git("rev-parse", "HEAD^{tree}")
    if args.target == "windows-x64":
        # Newly added build inputs must be in corresponding source, not merely
        # present as untracked files in a maintainer working directory.
        for relative in ("scripts/build-review-preview", "packaging/windows_preview_launcher.py",
                         "packaging/windows_preview_launcher.c"):
            indexed = subprocess.check_output(["git", "show", f"{tree}:{relative}"], cwd=ROOT, timeout=30)
            if indexed != (ROOT / relative).read_bytes():
                raise ValueError(f"Build input differs from the selected source tree: {relative}")
    if os.environ.get("CI") and not clean:
        raise ValueError("CI packages must match the exact checked-out commit")
    out = args.output.resolve()
    if out.exists() and any(out.iterdir()):
        raise ValueError('Output must be new or empty. No existing package is overwritten')
    out.mkdir(parents=True, exist_ok=True)
    deps = dependencies()
    decimal = decimal_component(args.target)
    work = out / "work"
    command = [sys.executable, "-m", "PyInstaller", "--clean", "--noconfirm", "--onedir", "--console",
               "--noupx", "--name", NAME, "--distpath", str(out / "dist"), "--workpath", str(work),
               "--specpath", str(work), "--paths", str(ROOT), "--add-data",
               f"{ROOT / 'experimental_modeling/review_static'}:experimental_modeling/review_static"]
    for module in EXCLUDES:
        command += ["--exclude-module", module]
    if sys.platform == "darwin":
        command += ["--target-arch", "arm64"]
    command.append(str(ROOT / "packaging/review_preview_entry.py"))
    subprocess.run(command, cwd=ROOT, check=True, timeout=600)
    bundle = out / "dist" / NAME
    collect_notices(bundle)
    framework_sealing = seal_macos_framework(bundle, args.target)
    if framework_sealing is not None:
        write_json(out / "macos-framework-sealing.json", framework_sealing)
    launcher_build = None
    if args.target == "windows-x64":
        launcher_build = windows_launcher.build_launcher(bundle, work)
        write_json(out / "windows-launcher-build.json", launcher_build)
    native, excluded = native_inventory(bundle, work, args.target)
    native_pe = windows_launcher.native_pe_inventory(bundle) if args.target == "windows-x64" else None
    decimal = bind_decimal_component(decimal, native, args.target)
    (bundle / "source").mkdir()
    with (bundle / "source" / "hbcb-corresponding-source.tar.gz").open("wb") as stream:
        subprocess.run(["git", "archive", "--format=tar.gz", "--prefix=hbcb-source/", tree],
                       cwd=ROOT, stdout=stream, check=True, timeout=60)
    shutil.copy2(ROOT / "docs/review-preview.md", bundle / "README.md")
    shutil.copy2(ROOT / "packaging/review-preview-requirements.lock", bundle / "source" / "build-requirements.lock")
    provenance = {"schema_version": 1, "product": "HBCB REVIEW PREVIEW", "scope": "existing-project read-only review",
                  "target": args.target, "commit": commit, "source_tree": tree, "commit_matches_source": clean,
                  "python": platform.python_version(), "python_build": sys.version, "standard_gil": True,
                  "python_executable_sha256": sha256(Path(sys.executable)),
                  "system": platform.system(), "machine": platform.machine(), "os_release": platform.release(),
                  "build_dependencies": deps, "dependency_lock_sha256": sha256(ROOT / "packaging/review-preview-requirements.lock"),
                  "runner_image": os.environ.get("ImageOS"), "runner_image_version": os.environ.get("ImageVersion"),
                  "workflow_run": os.environ.get("GITHUB_RUN_ID"), "workflow_attempt": os.environ.get("GITHUB_RUN_ATTEMPT"),
                  "setup_python_action": "e797f83bcb11b83ae66e0230d6156d7c80228e7c",
                  "python_distribution": ("Local validation runtime, not for distribution" if args.target == "linux-validation" else "Official python.org runtime via pinned actions/setup-python; installed runtime bytes recorded separately"),
                  "signing": "No publisher signature or notarization; macOS ad-hoc loader signature only",
                  "changes": "Frozen Python module closure, relocated runtime and static reviewer; unused modules excluded; macOS arm64 thinning and final framework resource sealing; Microsoft runtime not redistributed",
                  "excluded_modules": EXCLUDES, "native_components": native, "external_microsoft_runtime": excluded,
                  "static_components": [
                      decimal,
                      {"component": "HACL* hash code and KaRaMeL support in CPython", "version": "bb3d0dc8d9d15a5cd51094d5b69e70aa09005ff0",
                       "license_files": ["licenses/CPython-hacl-NOTICES.txt", "licenses/Apache-2.0.txt"]},
                      {"component": "BLAKE2 in CPython", "version": "libb2 0.98.1 as vendored in CPython 3.13.16",
                       "license_files": ["licenses/CPython-blake2-NOTICES.txt", "licenses/CC0-1.0.txt"]},
                      {"component": "Expat in CPython", "version": "2.8.5", "license_files": ["licenses/CPython-expat-COPYING.txt"]},
                      {"component": "mimalloc, Unicode and other incorporated CPython code", "version": "CPython 3.13.16 source notices",
                       "license_files": ["licenses/CPython-incorporated-software.rst"]},
                      {"component": "PyInstaller Windows bootloader zlib", "version": "1.3.2", "applicable": args.target == "windows-x64",
                       "license_files": ["licenses/PyInstaller-zlib-LICENSE.txt"]}],
                  "system_libraries": "Provided by the target OS, not redistributed",
                  "runtime_network": "127.0.0.1 review server only; no downloads or provider calls"}
    if framework_sealing is not None:
        provenance["macos_framework_sealing"] = framework_sealing
    if launcher_build is not None:
        provenance["windows_launcher"] = launcher_build
        provenance["windows_native_pe"] = native_pe
    write_json(bundle / "provenance.json", provenance)
    write_json(bundle / MANIFEST, {"schema_version": 1, "files": inventory(bundle)})
    verify(bundle)
    suffix = "zip" if args.target == "windows-x64" else "tar.gz"
    archive = out / f"{NAME}-{tree[:12]}-{args.target}.{suffix}"
    if suffix == "zip":
        with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED) as stream:
            for path in sorted(bundle.rglob("*")):
                if path.is_symlink():
                    raise ValueError("Windows ZIP unexpectedly contains a symlink")
                stream.write(path, path.relative_to(bundle.parent))
    else:
        with tarfile.open(archive, "w:gz", format=tarfile.PAX_FORMAT) as stream:
            stream.add(bundle, arcname=NAME)
    (out / "SHA256SUMS").write_text(f"{sha256(archive)}  {archive.name}\n", encoding="ascii")
    shutil.copy2(bundle / "provenance.json", out / "provenance.json")
    write_json(out / "build-result.json", {"archive": archive.name, "sha256": sha256(archive), "target": args.target,
                                          "source_tree": tree, "commit": commit, "native_smoke_test": "not_yet_run"})
    print(archive)


if __name__ == "__main__":
    main()

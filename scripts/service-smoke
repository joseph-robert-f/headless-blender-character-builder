#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'SERVICE_SMOKE: usage: scripts/service-smoke' >&2
  exit 2
fi

python_bin=${PYTHON:-python3}
docker_bin=${DOCKER:-docker}
valid_tool_selector() {
  [ "${#1}" -le 4096 ] || return 1
  case "$1" in ''|-*|*[![:graph:]]*) return 1 ;; esac
}
if ! valid_tool_selector "$python_bin" || ! valid_tool_selector "$docker_bin"; then
  printf '%s\n' 'SERVICE_SMOKE: PYTHON and DOCKER must each name one safe executable' >&2
  exit 3
fi
if ! command -v "$python_bin" >/dev/null 2>&1; then
  printf '%s\n' "SERVICE_SMOKE: Python 3.11+ is unavailable ($python_bin)" >&2
  exit 3
fi
python_version=$("$python_bin" --version 2>&1 | sed -n '1p' || true)
if ! "$python_bin" -c \
  'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
  >/dev/null 2>&1; then
  printf '%s\n' "SERVICE_SMOKE: Python 3.11+ is required (found: ${python_version:-unknown})" >&2
  exit 3
fi

if [ ! -r ./scripts/service-common ]; then
  printf '%s\n' 'SERVICE_SMOKE: run from the repository root' >&2
  exit 2
fi
# shellcheck source=service-common
. ./scripts/service-common

if [ ! -f .env ]; then
  printf '%s\n' 'SERVICE_SMOKE: .env is missing; run make init-env' >&2
  exit 3
fi
if ! hbcb_service_env_private; then
  printf '%s\n' 'SERVICE_SMOKE: .env must be an owned mode-0600 regular file' >&2
  exit 3
fi
if ! hbcb_service_settings; then
  printf '%s\n' 'SERVICE_SMOKE: local-service project or loopback-port settings are invalid' >&2
  exit 3
fi
hbcb_service_identity

DOCKER=$docker_bin
PYTHON=$python_bin
export DOCKER PYTHON

compose() {
  if [ -n "${HBCB_COMPOSE_BIN:-}" ]; then
    "$HBCB_COMPOSE_BIN" --project-name "$HBCB_COMPOSE_PROJECT_NAME" "$@"
  else
    "$docker_bin" compose --project-name "$HBCB_COMPOSE_PROJECT_NAME" "$@"
  fi
}

case "${BUILDER_IMAGE:-}" in
  ''|headless-blender-character-builder:dev)
    builder_image=$HBCB_BUILDER_PROJECT_IMAGE
    ;;
  *) builder_image=$BUILDER_IMAGE ;;
esac
case "$builder_image" in
  -*|*[![:graph:]]*)
    printf '%s\n' 'SERVICE_SMOKE: builder image reference is invalid' >&2
    exit 4
    ;;
esac
if [ "${#builder_image}" -gt 512 ]; then
  printf '%s\n' 'SERVICE_SMOKE: builder image reference is invalid' >&2
  exit 4
fi
builder_metadata=$("$docker_bin" image inspect \
  --format '{{.Os}}/{{.Architecture}}|{{.Id}}' "$builder_image")
builder_platform=${builder_metadata%%|*}
builder_id=${builder_metadata#*|}
if [ "$builder_platform" != linux/amd64 ]; then
  printf '%s\n' 'SERVICE_SMOKE: builder image platform must be linux/amd64' >&2
  exit 4
fi
case "$builder_id" in
  sha256:????????????????????????????????????????????????????????????????) ;;
  *)
    printf '%s\n' 'SERVICE_SMOKE: builder image ID is invalid' >&2
    exit 4
    ;;
esac
# Compose passes this value to Dockerfile FROM, which requires a named image
# reference.  The measured immutable ID remains separate for provenance checks.
HBCB_BUILDER_IMAGE=$builder_image
HBCB_BUILDER_IMAGE_REFERENCE=$builder_image
HBCB_BUILDER_IMAGE_ID=$builder_id
export HBCB_BUILDER_IMAGE HBCB_BUILDER_IMAGE_REFERENCE HBCB_BUILDER_IMAGE_ID

mkdir -p build/service-smoke
run_root=$(mktemp -d "$(pwd)/build/service-smoke/run.XXXXXX")
chmod 0700 "$run_root"
request=$(pwd)/examples/requests/facet-bot.json
host_uid=$(id -u)
runtime_uid=$host_uid
runtime_gid=$(id -g)
if [ "$runtime_uid" = 0 ]; then runtime_uid=65532; fi
if [ "$runtime_gid" = 0 ]; then runtime_gid=65532; fi
if [ "$host_uid" = 0 ]; then chown "$runtime_uid:$runtime_gid" "$run_root"; fi

"$docker_bin" run \
  --rm \
  --init \
  --platform linux/amd64 \
  --network none \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --pids-limit 512 \
  --cpus 4 \
  --memory 4g \
  --user "$runtime_uid:$runtime_gid" \
  --tmpfs /work:rw,nosuid,nodev,noexec,size=2g,mode=1777 \
  --mount "type=bind,source=$request,target=/input/request.json,readonly" \
  --mount "type=bind,source=$run_root,target=/output" \
  --env HBCB_EXECUTION_MODE=container \
  --env "HBCB_WORKER_IMAGE_REFERENCE=$builder_image" \
  --env "HBCB_WORKER_IMAGE_ID=$builder_id" \
  "$builder_id" \
  build --request /input/request.json --output /output/direct

"$python_bin" tests/service_integration/g7_service_smoke.py \
  --base-url "http://127.0.0.1:$HBCB_API_HOST_PORT" \
  --api-port "$HBCB_API_HOST_PORT" \
  --storage-port "$HBCB_STORAGE_HOST_PORT" \
  --compose-project "$HBCB_COMPOSE_PROJECT_NAME" \
  --env-file .env \
  --direct-output "$run_root/direct" \
  --service-output "$run_root/service" \
  --summary "$run_root/g7-service-summary.json"

# The host-side integration gate creates the downloaded service artifacts.  A
# root-run CI host would otherwise leave them unreadable to the non-root
# verifier below.  Only this invocation's freshly-created evidence directory
# is adjusted.
if [ "$host_uid" = 0 ]; then chown -R "$runtime_uid:$runtime_gid" "$run_root"; fi

"$docker_bin" run \
  --rm \
  --init \
  --platform linux/amd64 \
  --network none \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --pids-limit 512 \
  --cpus 4 \
  --memory 4g \
  --user "$runtime_uid:$runtime_gid" \
  --tmpfs /work:rw,nosuid,nodev,noexec,size=2g,mode=1777 \
  --mount "type=bind,source=$request,target=/input/request.json,readonly" \
  --mount "type=bind,source=$run_root,target=/output,readonly" \
  --env HBCB_EXECUTION_MODE=container \
  --env "HBCB_WORKER_IMAGE_REFERENCE=$builder_image" \
  --env "HBCB_WORKER_IMAGE_ID=$builder_id" \
  "$builder_id" \
  verify --request /input/request.json --output /output/service

compose --env-file .env --profile test run --rm --build service-test \
  tests/service_integration/g7_redis_gate.py

compose --env-file .env --profile test run --rm service-test \
  tests/service_integration/g7_iam_gate.py

compose --env-file .env --profile test run --rm service-test \
  tests/service_integration/g8_lifecycle_gate.py

printf 'SERVICE_SMOKE: PASS project=%s evidence=%s\n' \
  "$HBCB_COMPOSE_PROJECT_NAME" "$run_root"

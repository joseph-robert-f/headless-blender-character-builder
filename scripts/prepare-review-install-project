#!/usr/bin/env python3
"""Recreate the delivered lamp ZIP from its original, hash-bound CI evidence."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path, PurePosixPath
import stat
import zipfile

ROOT = Path(__file__).resolve().parents[1]
FIXTURE = ROOT / "tests/experimental_modeling/fixtures/install_lamp"


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def prepare(source: Path, output: Path):
    manifest = json.loads((FIXTURE / "manifest.json").read_text())
    if output.exists():
        raise ValueError("Use a new output path.")
    files = {}
    for name, expected in manifest["files"].items():
        relative = PurePosixPath(name)
        if relative.is_absolute() or ".." in relative.parts or "\\" in name:
            raise ValueError("Unsafe fixture path.")
        if name == "README.txt":
            path = FIXTURE / name
        elif name == "verification-summary.json":
            path = source / "external-lamp-summary.json"
        else:
            path = source / "project" / relative
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"Missing regular source file: {name}")
        data = path.read_bytes()
        if sha256(data) != expected:
            raise ValueError(f"Original lamp file hash differs: {name}")
        files[name] = data
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("xb") as stream, zipfile.ZipFile(stream, "w") as archive:
        for name in sorted(manifest["directories"]):
            info = zipfile.ZipInfo(name, (2026, 10, 1, 0, 0, 0))
            info.create_system = 3
            info.external_attr = (stat.S_IFDIR | 0o755) << 16 | 0x10
            archive.writestr(info, b"")
        for name, data in sorted(files.items()):
            info = zipfile.ZipInfo("desk-lamp-demo/" + name, (2026, 10, 1, 0, 0, 0))
            info.create_system = 3
            info.external_attr = (stat.S_IFREG | 0o644) << 16
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(info, data, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)
    with zipfile.ZipFile(output) as archive:
        actual = {row.filename.removeprefix("desk-lamp-demo/"): sha256(archive.read(row))
                  for row in archive.infolist() if not row.is_dir()}
        if actual != manifest["files"]:
            raise ValueError("Repacked lamp file hashes differ.")
        if sorted(row.filename for row in archive.infolist() if row.is_dir()) != sorted(manifest["directories"]):
            raise ValueError("Repacked lamp directory list differs.")
    digest = sha256(output.read_bytes())
    report = {"schema_version": 1, "successful": True, "archive": str(output),
              "archive_sha256": digest, "files": len(files),
              "same_file_bytes_and_directories_as_delivered_project": True,
              "same_archive_bytes": digest == manifest["delivered_project_archive_sha256"],
              "scope": "Original lamp project bytes; ZIP compression can differ between host tools.",
              "source_commit": manifest["source_commit"], "source_run": manifest["source_run"],
              "source_artifact": manifest["source_artifact"]}
    output.with_suffix(".json").write_text(json.dumps(report, indent=2) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    print(json.dumps(prepare(args.source.resolve(strict=True), args.output), indent=2))


if __name__ == "__main__":
    main()

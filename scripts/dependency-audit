PACKAGE_LINE = re.compile(r"^([A-Za-z0-9][A-Za-z0-9_.-]*)==([^\s\\]+)\s*\\$")
HASH_LINE = re.compile(r"^\s+--hash=sha256:([0-9a-f]{64})(?:\s*\\)?$")
EXACT_REQUIREMENT = re.compile(
    r"^([A-Za-z0-9][A-Za-z0-9_.-]*)(?:\[([A-Za-z0-9_,.-]+)\])?==([^;\s]+)$"
)
IMAGE_REFERENCE = re.compile(
    r"^(?P<repository>[a-z0-9][a-z0-9._/-]*):(?P<tag>[^@\s]+)@sha256:(?P<digest>[0-9a-f]{64})$"
)
NUMERIC_TAG = re.compile(r"^(?P<version>[0-9]+(?:\.[0-9]+){1,2})(?P<suffix>-.+)?$")

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::hbcb-artifacts"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::hbcb-artifacts"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "local/v1/builds/",
            "local/v1/builds/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::hbcb-artifacts/local/v1/builds/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::hbcb-artifacts/local/v1/builds/*"
      ],
      "Condition": {
        "StringLike": {
          "s3:versionid": "????????-????-????-????-????????????"
        }
      }
    }
  ]
}

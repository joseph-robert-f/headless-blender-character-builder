# VPS configuration without secrets.
# Copy this file to a protected operator path.
# Replace each example value.
# SECRETS.md identifies the role files for secrets.
# release.lock.env contains the release image pins.
HBCB_DEPLOYMENT_NAMESPACE=production
POSTGRES_DB=hbcb

HBCB_API_DOMAIN=builder.example.com
HBCB_ACME_EMAIL=operator@example.com

HBCB_VPS_SECRETS_DIR=/etc/hbcb/secrets
HBCB_VPS_STATE_DIR=/var/lib/hbcb
HBCB_BACKUP_ROOT=/var/backups/hbcb

# This external network must have Docker Internal=true.
# Attach an operator-managed gateway for one maintained, versioned S3 endpoint.
# Do not give the API or worker a general host or default-egress network.
HBCB_STORAGE_NETWORK=hbcb-storage-private
HBCB_STORAGE_INTERNAL_ENDPOINT=s3-gateway:443
HBCB_STORAGE_PUBLIC_ENDPOINT=artifacts.example.com:443
HBCB_STORAGE_INTERNAL_SECURE=true
HBCB_STORAGE_PUBLIC_SECURE=true
HBCB_STORAGE_REGION=us-east-1
HBCB_STORAGE_BUCKET=hbcb-production-artifacts
HBCB_SIGNED_URL_TTL_SECONDS=300

HBCB_RETENTION_SUCCEEDED_DAYS=30
HBCB_RETENTION_OTHER_DAYS=7
HBCB_ORPHAN_GRACE_DAYS=7

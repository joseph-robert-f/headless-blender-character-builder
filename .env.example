# Local Compose input template. Run `make init-env` to create `.env` with
# random mode-0600 credentials. Compose maps only each role's scoped values to
# its generic HBCB_DATABASE_URL and HBCB_STORAGE_* process settings; this file
# is intentionally not a direct process environment. Placeholders are rejected.
HBCB_DEPLOYMENT_NAMESPACE=local
HBCB_API_TOKEN=replace-me-with-64-random-hex-characters
HBCB_IDEMPOTENCY_SECRET=replace-me-with-64-random-hex-characters

POSTGRES_DB=hbcb
POSTGRES_USER=hbcb_admin
POSTGRES_PASSWORD=replace-me-with-a-random-postgres-admin-password
HBCB_DATABASE_API_USER=hbcb_api
HBCB_DATABASE_API_PASSWORD=replace-me-with-a-random-api-database-password
HBCB_DATABASE_WORKER_USER=hbcb_worker
HBCB_DATABASE_WORKER_PASSWORD=replace-me-with-a-random-worker-database-password
HBCB_DATABASE_MAINTENANCE_USER=hbcb_maintenance
HBCB_DATABASE_MAINTENANCE_PASSWORD=replace-me-with-a-random-maintenance-database-password
HBCB_DATABASE_MIGRATOR_USER=hbcb_migrator
HBCB_DATABASE_MIGRATOR_PASSWORD=replace-me-with-a-random-migration-password

REDIS_PASSWORD=replace-me-with-a-random-redis-password

MINIO_ROOT_USER=hbcb_root
MINIO_ROOT_PASSWORD=replace-me-with-a-random-minio-root-password
HBCB_STORAGE_API_ACCESS_KEY=hbcb_api
HBCB_STORAGE_API_SECRET_KEY=replace-me-with-a-random-api-storage-secret
HBCB_STORAGE_WORKER_ACCESS_KEY=hbcb_worker
HBCB_STORAGE_WORKER_SECRET_KEY=replace-me-with-a-random-worker-storage-secret
HBCB_STORAGE_MAINTENANCE_ACCESS_KEY=hbcb_maintenance
HBCB_STORAGE_MAINTENANCE_SECRET_KEY=replace-me-with-a-random-maintenance-storage-secret
HBCB_STORAGE_BUCKET=hbcb-artifacts
HBCB_STORAGE_INTERNAL_ENDPOINT=minio:9000
HBCB_STORAGE_PUBLIC_ENDPOINT=localhost:9000
HBCB_STORAGE_INTERNAL_SECURE=false
HBCB_STORAGE_PUBLIC_SECURE=false
HBCB_STORAGE_REGION=us-east-1
HBCB_SIGNED_URL_TTL_SECONDS=300

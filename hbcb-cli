#!/usr/bin/env python3
"""Run the CLI straight from a clone, with nothing installed.

    ./hbcb-cli build --preset facet-bot -o build/facet-bot

`pip install .` provides the same thing as an `hbcb` command on PATH.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from hbcb.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
